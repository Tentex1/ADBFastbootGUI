<Window x:Class="ADBFastbootGUI.Windows.ProgramUninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADBFastbootGUI.Windows"
        mc:Ignorable="d"
        WindowStyle="None"
        BorderThickness="0"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        Title="ProgramUninstallDialog" Height="508.3" Width="522.875">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" ResizeBorderThickness="0" CaptionHeight="0" CornerRadius="20"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <TextBox x:Name="SearchBox" FontSize="15" Margin="10,34,10,0" Height="30" VerticalAlignment="Top" TextChanged="SearchBox_TextChanged" Style="{x:Null}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2" VerticalContentAlignment="Center"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,79,10,49">
            <StackPanel x:Name="PackageListPanel"/>
        </ScrollViewer>

        <CheckBox x:Name="KeepDataCheckBox" Content="Keep the cache and data left by the program" FontSize="15" Margin="0,450,195,10"/>
        <TextBlock x:Name="Title" Text="Packages" FontSize="20" HorizontalAlignment="Center" Margin="217,0,217,475"/>
        <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="30" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,5,10" Click="CancelButton_Click"/>
        <Button x:Name="UninstallAppButton" Content="Uninstall" Width="90" Height="30" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,100,10" Click="UninstallAppButton_Click"/>

    </Grid>
</Window>
