<Window x:Class="ADBFastbootGUI.Windows.ProgressBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ADBFastbootGUI.Windows" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="ProgressBar"
        Width="391.903" Height="164.48"
        Background="{DynamicResource MaterialDesignPaper}"
        BorderThickness="0"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <TextBlock x:Name="Info"
                   Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                   FontSize="20" Text="" />
        <ProgressBar x:Name="ADBServerStartingProgressBar"
                     Height="3"
                     Margin="20,68,20,53"
                     Background="{DynamicResource MaterialDesignPaper}"
                     BorderThickness="0" IsIndeterminate="True" Maximum="100" Minimum="0"
                     Style="{StaticResource MaterialDesignCircularProgressBar}" />
        <Button x:Name="CloseButton"
                Height="25"
                Margin="159,0,159,7" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Click="CloseButton_Click" Content="Close" Visibility="Collapsed" />
    </Grid>
</Window>
