<Window x:Class="ADBFastbootGUI.Windows.PartitionManagement.EraseLogicalPartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADBFastbootGUI.Windows.PartitionManagement"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Loaded="Window_Loaded"
        ShowInTaskbar="False"
        Title="EraseLogicalPartitionWindow" Height="175.405" Width="327.575">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" ResizeBorderThickness="0" CaptionHeight="0" CornerRadius="20"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <TextBlock Text="Enter partition name:" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>

        <TextBox x:Name="PartitionNameTextBox" FontSize="15" Margin="10,34,10,0" Height="30" VerticalAlignment="Top" Style="{x:Null}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2" VerticalContentAlignment="Center"/>

        <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="30" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,5,10" Click="CancelButton_Click"/>
        <Button x:Name="ErasePartitionButton" Content="Erase Logical Partition" Width="172" Height="30" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,100,10" Click="ErasePartitionButton_Click"/>
    </Grid>
</Window>
