<Window x:Class="ADBFastbootGUI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADBFastbootGUI.Windows"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        Title="SettingsWindow" Height="298.477" Width="167.908">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" ResizeBorderThickness="0" CaptionHeight="0" CornerRadius="20"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        <TextBlock x:Name="Header" Text="Settings" FontSize="20" HorizontalAlignment="Center" Margin="44,0,44,261"/>
        <CheckBox x:Name="ThemeCheckBox" Checked="ThemeCheckBox_Checked" Unchecked="ThemeCheckBox_Unchecked" Content="Dark Mode" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,57,0,0" FontSize="15" IsChecked="False"/>
        <Rectangle Fill="{DynamicResource PrimaryHueMidBrush}" Height="2" Margin="10,81,10,207"/>
        <TextBlock x:Name="CTTitle" Text="Color Theme" FontSize="15" HorizontalAlignment="Center" Margin="38,86,38,183"/>
        <ComboBox x:Name="ColorThemeComboBox" Style="{x:Null}" Margin="0,112,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="140" HorizontalContentAlignment="Center" SelectedIndex="3">
            <ComboBoxItem Content="Yellow"/>
            <ComboBoxItem Content="Teal"/>
            <ComboBoxItem Content="Deep Purple"/>
            <ComboBoxItem Content="Lime"/>
            <ComboBoxItem Content="Blue Grey"/>
            <ComboBoxItem Content="Amber"/>
            <ComboBoxItem Content="Cyan"/>
            <ComboBoxItem Content="Indigo"/>
            <ComboBoxItem Content="Red"/>
            <ComboBoxItem Content="Gray"/>
            <ComboBoxItem Content="Deep Orange"/>
            <ComboBoxItem Content="Pink"/>
            <ComboBoxItem Content="Light Green"/>
            <ComboBoxItem Content="Orange"/>
            <ComboBoxItem Content="Brown"/>
            <ComboBoxItem Content="Light Blue"/>
            <ComboBoxItem Content="Green"/>
            <ComboBoxItem Content="Blue"/>
            <ComboBoxItem Content="Purple"/>
        </ComboBox>

        <Button x:Name="SetColorThemeButton" Content="Set Color Theme" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,140,10,0" Width="138" Click="SetColorThemeButton_Click"/>
        <Button x:Name="ExitButton" Content="Exit" Width="90" Height="30" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" Click="ExitButton_Click"/>
    </Grid>
</Window>
