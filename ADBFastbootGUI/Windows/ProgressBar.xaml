<Window x:Class="ADBFastbootGUI.Windows.ProgressBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADBFastbootGUI.Windows"
        mc:Ignorable="d"
        WindowStyle="None"
        Loaded="Window_Loaded"
        BorderThickness="0"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="ProgressBar" Height="164.48" Width="391.903">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" ResizeBorderThickness="0" CaptionHeight="0" CornerRadius="20"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <TextBlock x:Name="Info" FontSize="20" Text="" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <ProgressBar x:Name="ADBServerStartingProgressBar" Minimum="0" Maximum="100" Height="35" Margin="20,68,20,53" Background="White" BorderBrush="Black" Foreground="Black" IsIndeterminate="True"/>
        <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="25" Click="CloseButton_Click" Margin="159,0,159,7" Visibility="Collapsed"/>
    </Grid>
</Window>
